# ─── API ────────────────────────────────────────────────────────────────────
# Production PostgreSQL connection. When omitted the API boots an embedded
# PGlite database (real Postgres engine, file-backed) for zero-setup local dev.
# DATABASE_URL=postgresql://paylane:paylane@localhost:5432/paylane

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
WEB_ORIGIN=http://localhost:3100
API_PORT=4000
NODE_ENV=development
COOKIE_SECURE=false

# HMAC secret used to sign inbound vendor webhooks.
VENDOR_WEBHOOK_SECRET=dev-vendor-webhook-secret

# ─── Identity vendor (NIN / BVN / slips / record services) ──────────────────
# Leave every value below blank until your verification partner issues
# credentials. With no base URL and API key the API runs the sandbox adapter
# and the UI labels results as "Sandbox results". Fill these in and the same
# routes switch to the live vendor; no code changes are required.
#
# IDENTITY_VENDOR_MODE=AUTO   # AUTO | HTTP | MOCK. AUTO = HTTP when configured.
# IDENTITY_VENDOR_BASE_URL=
# IDENTITY_VENDOR_API_KEY=
# IDENTITY_VENDOR_API_SECRET=
# IDENTITY_VENDOR_VERIFY_PATH=/verify
# IDENTITY_VENDOR_TIMEOUT_MS=15000
#
# How long completed results stay readable before the retention purge removes
# the stored result payload. Raw NIN/BVN values are never persisted; only an
# HMAC digest and a masked subject are stored.
# IDENTITY_RESULT_RETENTION_DAYS=90
#
# HMAC key for NIN/BVN digests. Defaults to JWT_SECRET when omitted.
# IDENTITY_DIGEST_SECRET=

# ─── API keys ───────────────────────────────────────────────────────────────
# Pepper mixed into the SHA-256 hash of developer API keys. Defaults to
# JWT_SECRET when omitted. Rotating this invalidates every issued key.
# API_KEY_PEPPER=

# ─── Web ────────────────────────────────────────────────────────────────────
# Internal URL used by Next.js server components to call the API.
API_INTERNAL_URL=http://localhost:4000

# ─── Google AdSense ─────────────────────────────────────────────────────────
# Leave these unset to render the labelled ad placeholders used in development.
# Set the publisher id once AdSense approves the site, then add one slot id per
# placement. Slot ids come from AdSense → Ads → By ad unit.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_INLINE=0000000000
#
# Before going live, publish https://your-domain/ads.txt with the line:
#   google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
